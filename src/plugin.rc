#include <windows.h>
#include "ui-resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 300, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OBS SOCKS5 Proxy Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX   "Enable proxy",                 IDC_ENABLED, 10, 10, 130, 10
    AUTOCHECKBOX   "Proxy browser sources",        IDC_BROWSER, 10, 24, 160, 10
    AUTOCHECKBOX   "Use proxy list from URL",      IDC_USELIST, 10, 38, 160, 10

    LTEXT          "List URL:",                    -1, 10, 55, 45, 10
    EDITTEXT       IDC_LISTURL,                    58, 53, 232, 12, ES_AUTOHSCROLL
    LTEXT          "Refresh (sec):",               -1, 10, 72, 55, 10
    EDITTEXT       IDC_REFRESH,                    66, 70, 50, 12, ES_AUTOHSCROLL | ES_NUMBER

    GROUPBOX       "Static / fallback proxy",      -1, 7, 88, 286, 92
    LTEXT          "Host:",                        -1, 18, 102, 40, 10
    EDITTEXT       IDC_HOST,                       66, 100, 160, 12, ES_AUTOHSCROLL
    LTEXT          "Port:",                        -1, 18, 118, 40, 10
    EDITTEXT       IDC_PORT,                       66, 116, 55, 12, ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX   "Use authentication",           IDC_USEAUTH, 18, 134, 160, 10
    LTEXT          "Username:",                    -1, 18, 150, 45, 10
    EDITTEXT       IDC_USER,                       66, 148, 160, 12, ES_AUTOHSCROLL
    LTEXT          "Password:",                    -1, 18, 166, 45, 10
    EDITTEXT       IDC_PASS,                       66, 164, 160, 12, ES_AUTOHSCROLL | ES_PASSWORD

    PUSHBUTTON     "Reload list now",              IDC_RELOAD, 10, 190, 90, 16
    DEFPUSHBUTTON  "OK",                           IDOK, 178, 190, 52, 16
    PUSHBUTTON     "Cancel",                       IDCANCEL, 238, 190, 52, 16
END
